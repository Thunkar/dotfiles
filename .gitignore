.claude/

# Wallpaper is a per-machine choice (binary). Keep the dir, ignore images.
wallpapers/*
!wallpapers/.gitkeep

# matugen-generated palette (machine-derived, like the wallpaper)
theme/colors.env

# Per-machine Hyprland files: monitor layout (read by conf/monitors.lua) and
# optional overrides loaded last by hyprland.lua
hypr/machine.lua
hypr/local.lua
