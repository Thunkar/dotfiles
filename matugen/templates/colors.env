# GENERATED BY MATUGEN — do not edit by hand.
# Source: the wallpaper passed to `matugen image …` (see apply.sh
# generate_palette). Material You's harmonised roles (primary /
# secondary / tertiary / error + neutrals) are mapped onto the
# generic, semantic token names the rest of the repo's .tpl files use.
# Names describe ROLE (ACCENT, SUCCESS, BORDER…), not a fixed hue —
# the actual colours follow whatever wallpaper is active.

# ── Backgrounds (dark → darker) ──────────────────────────────────
BG={{colors.surface.default.hex_stripped}}
BG_R={{colors.surface.default.red}}
BG_G={{colors.surface.default.green}}
BG_B={{colors.surface.default.blue}}
BG_ALT={{colors.surface_container_low.default.hex_stripped}}
BG_ALT_R={{colors.surface_container_low.default.red}}
BG_ALT_G={{colors.surface_container_low.default.green}}
BG_ALT_B={{colors.surface_container_low.default.blue}}
BG_DEEP={{colors.surface_container_lowest.default.hex_stripped}}
BG_DEEP_R={{colors.surface_container_lowest.default.red}}
BG_DEEP_G={{colors.surface_container_lowest.default.green}}
BG_DEEP_B={{colors.surface_container_lowest.default.blue}}

# ── Surfaces (raised UI) ─────────────────────────────────────────
SURFACE0={{colors.surface_container.default.hex_stripped}}
SURFACE0_R={{colors.surface_container.default.red}}
SURFACE0_G={{colors.surface_container.default.green}}
SURFACE0_B={{colors.surface_container.default.blue}}
SURFACE1={{colors.surface_container_high.default.hex_stripped}}
SURFACE1_R={{colors.surface_container_high.default.red}}
SURFACE1_G={{colors.surface_container_high.default.green}}
SURFACE1_B={{colors.surface_container_high.default.blue}}
SURFACE2={{colors.surface_container_highest.default.hex_stripped}}
SURFACE2_R={{colors.surface_container_highest.default.red}}
SURFACE2_G={{colors.surface_container_highest.default.green}}
SURFACE2_B={{colors.surface_container_highest.default.blue}}

# ── Foreground / text scale ──────────────────────────────────────
FG={{colors.on_surface.default.hex_stripped}}
FG_R={{colors.on_surface.default.red}}
FG_G={{colors.on_surface.default.green}}
FG_B={{colors.on_surface.default.blue}}
FG_DIM={{colors.on_surface_variant.default.hex_stripped}}
FG_DIM_R={{colors.on_surface_variant.default.red}}
FG_DIM_G={{colors.on_surface_variant.default.green}}
FG_DIM_B={{colors.on_surface_variant.default.blue}}
FG_FAINT={{colors.outline.default.hex_stripped}}
FG_FAINT_R={{colors.outline.default.red}}
FG_FAINT_G={{colors.outline.default.green}}
FG_FAINT_B={{colors.outline.default.blue}}

# ── Lines: muted text, hairline borders ──────────────────────────
MUTED={{colors.outline.default.hex_stripped}}
MUTED_R={{colors.outline.default.red}}
MUTED_G={{colors.outline.default.green}}
MUTED_B={{colors.outline.default.blue}}
BORDER={{colors.outline_variant.default.hex_stripped}}
BORDER_R={{colors.outline_variant.default.red}}
BORDER_G={{colors.outline_variant.default.green}}
BORDER_B={{colors.outline_variant.default.blue}}

# ── Accents (Material You roles, derived from the wallpaper) ──────
# ACCENT = primary hue; ACCENT_ALT = tertiary; *_DIM = softer tone.
ACCENT={{colors.primary.default.hex_stripped}}
ACCENT_R={{colors.primary.default.red}}
ACCENT_G={{colors.primary.default.green}}
ACCENT_B={{colors.primary.default.blue}}
ACCENT_DIM={{colors.primary_fixed_dim.default.hex_stripped}}
ACCENT_DIM_R={{colors.primary_fixed_dim.default.red}}
ACCENT_DIM_G={{colors.primary_fixed_dim.default.green}}
ACCENT_DIM_B={{colors.primary_fixed_dim.default.blue}}
ACCENT_ALT={{colors.tertiary.default.hex_stripped}}
ACCENT_ALT_R={{colors.tertiary.default.red}}
ACCENT_ALT_G={{colors.tertiary.default.green}}
ACCENT_ALT_B={{colors.tertiary.default.blue}}

# ── Semantic states (light enough to use as foreground text) ─────
SUCCESS={{colors.tertiary_fixed.default.hex_stripped}}
SUCCESS_R={{colors.tertiary_fixed.default.red}}
SUCCESS_G={{colors.tertiary_fixed.default.green}}
SUCCESS_B={{colors.tertiary_fixed.default.blue}}
WARNING={{colors.secondary.default.hex_stripped}}
WARNING_R={{colors.secondary.default.red}}
WARNING_G={{colors.secondary.default.green}}
WARNING_B={{colors.secondary.default.blue}}
ERROR={{colors.error.default.hex_stripped}}
ERROR_R={{colors.error.default.red}}
ERROR_G={{colors.error.default.green}}
ERROR_B={{colors.error.default.blue}}

# ── Theme-package aliases (GTK/cursor) — matugen drives GTK via
# colors.css, not the named package; kept stable. ─────────────────
GTK_THEME_NAME=adw-gtk3-dark
CURSOR_THEME_NAME=Adwaita
