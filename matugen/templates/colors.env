# GENERATED BY MATUGEN — do not edit by hand.
# Source: the wallpaper passed to `matugen image …` (see apply.sh
# generate_palette). Material You roles are mapped onto the token
# names the rest of the repo's .tpl files expect.
#
# Going wallpaper-driven means the old Catppuccin "rainbow" of 14
# distinct hues collapses onto Material You's harmonised roles
# (primary / secondary / tertiary / error + neutrals). Accent slots
# that used to be visually distinct (network teal vs bluetooth blue)
# now share tones derived from the image — that's the Material You
# look: everything matches the wallpaper.

# ── Backgrounds (dark → darker) ──────────────────────────────────
BASE={{colors.surface.default.hex_stripped}}
BASE_R={{colors.surface.default.red}}
BASE_G={{colors.surface.default.green}}
BASE_B={{colors.surface.default.blue}}

MANTLE={{colors.surface_container_low.default.hex_stripped}}
MANTLE_R={{colors.surface_container_low.default.red}}
MANTLE_G={{colors.surface_container_low.default.green}}
MANTLE_B={{colors.surface_container_low.default.blue}}

