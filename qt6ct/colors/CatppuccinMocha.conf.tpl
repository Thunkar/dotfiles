[ColorScheme]
# Catppuccin Mocha palette for qt6ct / qt5ct.
# 21 ARGB colors per group in order:
#   WindowText, Button, Light, Midlight, Dark, Mid, Text, BrightText,
#   ButtonText, Base, Window, Shadow, Highlight, HighlightedText, Link,
#   LinkVisited, AlternateBase, NoRole, ToolTipBase, ToolTipText,
#   PlaceholderText
#
# Colors → Catppuccin Mocha:
#   text=cdd6f4 base=1e1e2e mantle=181825 crust=11111b
#   surface0=313244 surface1=45475a surface2=585b70 overlay0=6c7086
#   mauve=cba6f7 (accent)  blue=89b4fa  lavender=b4befe

active_colors=#ff@TEXT@, #ff@SURFACE0@, #ff@SURFACE2@, #ff@SURFACE1@, #ff@CRUST@, #ff@MANTLE@, #ff@TEXT@, #ffffffff, #ff@TEXT@, #ff@BASE@, #ff@BASE@, #ff@CRUST@, #ff@MAUVE@, #ff@CRUST@, #ff@BLUE@, #ff@LAVENDER@, #ff@MANTLE@, #00000000, #ff@MANTLE@, #ff@TEXT@, #ff@OVERLAY0@
inactive_colors=#ff@TEXT@, #ff@SURFACE0@, #ff@SURFACE2@, #ff@SURFACE1@, #ff@CRUST@, #ff@MANTLE@, #ff@TEXT@, #ffffffff, #ff@TEXT@, #ff@BASE@, #ff@BASE@, #ff@CRUST@, #ff@MAUVE@, #ff@CRUST@, #ff@BLUE@, #ff@LAVENDER@, #ff@MANTLE@, #00000000, #ff@MANTLE@, #ff@TEXT@, #ff@OVERLAY0@
disabled_colors=#ff@OVERLAY0@, #ff@SURFACE0@, #ff@SURFACE2@, #ff@SURFACE1@, #ff@CRUST@, #ff@MANTLE@, #ff@OVERLAY0@, #ffffffff, #ff@OVERLAY0@, #ff@BASE@, #ff@BASE@, #ff@CRUST@, #ff@SURFACE1@, #ff@OVERLAY0@, #ff@BLUE@, #ff@LAVENDER@, #ff@MANTLE@, #00000000, #ff@MANTLE@, #ff@TEXT@, #ff@SURFACE1@
