[ColorScheme]
# palette for qt6ct / qt5ct.
# 21 ARGB colors per group in order:
#   WindowText, Button, Light, Midlight, Dark, Mid, Text, BrightText,
#   ButtonText, Base, Window, Shadow, Highlight, HighlightedText, Link,
#   LinkVisited, AlternateBase, NoRole, ToolTipBase, ToolTipText,
#   PlaceholderText
#
# Token mapping (Mocha values currently — overwrite via theme/colors.env):
#   text=cdd6f4 base=1e1e2e mantle=181825 crust=11111b
#   surface0=313244 surface1=45475a surface2=585b70 overlay0=6c7086
#   mauve=cba6f7 (accent)  blue=89b4fa  lavender=b4befe

active_colors=#ff@FG@, #ff@SURFACE0@, #ff@SURFACE2@, #ff@SURFACE1@, #ff@BG_DEEP@, #ff@BG_ALT@, #ff@FG@, #ffffffff, #ff@FG@, #ff@BG@, #ff@BG@, #ff@BG_DEEP@, #ff@ACCENT@, #ff@BG_DEEP@, #ff@ACCENT_ALT@, #ff@ACCENT_DIM@, #ff@BG_ALT@, #00000000, #ff@BG_ALT@, #ff@FG@, #ff@MUTED@
inactive_colors=#ff@FG@, #ff@SURFACE0@, #ff@SURFACE2@, #ff@SURFACE1@, #ff@BG_DEEP@, #ff@BG_ALT@, #ff@FG@, #ffffffff, #ff@FG@, #ff@BG@, #ff@BG@, #ff@BG_DEEP@, #ff@ACCENT@, #ff@BG_DEEP@, #ff@ACCENT_ALT@, #ff@ACCENT_DIM@, #ff@BG_ALT@, #00000000, #ff@BG_ALT@, #ff@FG@, #ff@MUTED@
disabled_colors=#ff@MUTED@, #ff@SURFACE0@, #ff@SURFACE2@, #ff@SURFACE1@, #ff@BG_DEEP@, #ff@BG_ALT@, #ff@MUTED@, #ffffffff, #ff@MUTED@, #ff@BG@, #ff@BG@, #ff@BG_DEEP@, #ff@SURFACE1@, #ff@MUTED@, #ff@ACCENT_ALT@, #ff@ACCENT_DIM@, #ff@BG_ALT@, #00000000, #ff@BG_ALT@, #ff@FG@, #ff@SURFACE1@
